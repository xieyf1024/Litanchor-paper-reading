{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xieyf1024/Litanchor-paper-reading/schemas/evidence-unit.schema.json",
  "title": "LitAnchor EvidenceUnit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "origin",
    "evidence_type",
    "page_index",
    "section",
    "quote_original",
    "context_before",
    "context_after",
    "epistemic_status",
    "contains_number",
    "contains_unit",
    "confidence",
    "extraction_confidence",
    "needs_review",
    "page_verified",
    "source_match_kind",
    "alignment_kind",
    "mineru_used_as",
    "authoritative_source"
  ],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^E-[A-Za-z0-9_-]+$"},
    "origin": {
      "enum": ["auto_extracted", "auto_synthesized", "curated", "user"]
    },
    "evidence_type": {
      "enum": [
        "summary",
        "paper_type",
        "research_question",
        "background",
        "prior_work",
        "research_gap",
        "hypothesis",
        "contribution",
        "data",
        "material",
        "preprocessing",
        "model",
        "method_step",
        "parameter",
        "metric",
        "experiment",
        "result",
        "figure",
        "table",
        "equation",
        "discussion",
        "limitation",
        "uncertainty",
        "conclusion",
        "future_work",
        "term",
        "writing_expression",
        "reference"
      ]
    },
    "page_index": {"type": "integer", "minimum": 1},
    "printed_page": {"type": ["string", "null"]},
    "section": {"type": "string", "minLength": 1},
    "block_id": {"type": ["string", "null"]},
    "bounding_box": {
      "oneOf": [
        {"type": "null"},
        {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 4, "maxItems": 4}
      ]
    },
    "quote_original": {"type": "string", "minLength": 1},
    "context_before": {"type": "string"},
    "context_after": {"type": "string"},
    "epistemic_status": {
      "enum": ["observed", "supported", "interpreted", "hypothesized", "speculative", "unknown"]
    },
    "epistemic_markers": {"type": "array", "items": {"type": "string"}},
    "contains_number": {"type": "boolean"},
    "contains_unit": {"type": "boolean"},
    "contains_variable": {"type": "boolean"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "extraction_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "needs_review": {"type": "boolean"},
    "page_verified": {"type": "boolean"},
    "source_match_kind": {
      "enum": ["exact", "normalized", "fuzzy", "unmatched"]
    },
    "alignment_kind": {
      "enum": ["exact", "normalized", "fuzzy", "unmatched"]
    },
    "mineru_used_as": {
      "enum": ["structure_hint", "not_used"]
    },
    "authoritative_source": {
      "const": "pymupdf_page"
    },
    "symbol_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method", "corrections"],
      "properties": {
        "status": {
          "enum": [
            "corrected_from_original_page",
            "verified_on_original_page"
          ]
        },
        "method": {"const": "pymupdf_page_render"},
        "corrections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["extracted", "verified"],
            "properties": {
              "extracted": {"type": "string", "minLength": 1},
              "verified": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "issues": {"type": "array", "items": {"type": "string"}}
  }
}
