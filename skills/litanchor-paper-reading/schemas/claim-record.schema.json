{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xieyf1024/Litanchor-paper-reading/schemas/claim-record.schema.json",
  "title": "LitAnchor ClaimRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "origin",
    "claim_text_zh",
    "claim_type",
    "section_target",
    "importance",
    "epistemic_status",
    "evidence_ids",
    "page_refs",
    "numeric_items",
    "conditions_zh",
    "validation"
  ],
  "properties": {
    "claim_id": {"type": "string", "pattern": "^C-[A-Za-z0-9_-]+$"},
    "origin": {
      "enum": ["auto_extracted", "auto_synthesized", "curated", "user"]
    },
    "claim_text_zh": {"type": "string", "minLength": 1},
    "claim_type": {
      "enum": [
        "summary",
        "paper_type",
        "question",
        "background",
        "prior_work",
        "gap",
        "hypothesis",
        "contribution",
        "data",
        "material",
        "preprocessing",
        "method",
        "model",
        "equation",
        "metric",
        "parameter",
        "experiment",
        "result",
        "figure_interpretation",
        "interpretation",
        "discussion",
        "limitation",
        "conclusion",
        "conclusion_boundary",
        "future_work",
        "learning_value",
        "research_idea",
        "term",
        "writing_expression",
        "reference"
      ]
    },
    "title_zh": {"type": ["string", "null"]},
    "provenance_class": {
      "enum": ["paper", "analysis", "hypothesis", "user"]
    },
    "detail_points_zh": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "section_id": {"type": ["string", "null"]},
    "section_target": {"type": "string", "minLength": 1},
    "importance": {"enum": ["core", "supporting", "context"]},
    "conditions_zh": {"type": ["string", "null"]},
    "epistemic_status": {
      "enum": ["observed", "supported", "interpreted", "hypothesized", "speculative", "unknown"]
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^E-[A-Za-z0-9_-]+$"}
    },
    "page_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "numeric_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value_original"],
        "properties": {
          "value_original": {"type": "string", "minLength": 1},
          "unit_original": {"type": ["string", "null"]},
          "variable": {"type": ["string", "null"]},
          "condition": {"type": ["string", "null"]}
        }
      }
    },
    "evidence_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tested_claim_zh",
        "comparison_conditions_zh",
        "observed_result_zh",
        "supported_conclusion_zh",
        "unsupported_stronger_interpretation_zh"
      ],
      "properties": {
        "tested_claim_zh": {"type": "string", "minLength": 1},
        "comparison_conditions_zh": {"type": "string", "minLength": 1},
        "observed_result_zh": {"type": "string", "minLength": 1},
        "supported_conclusion_zh": {"type": "string", "minLength": 1},
        "unsupported_stronger_interpretation_zh": {"type": "string", "minLength": 1}
      }
    },
    "research_idea": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_observation_zh",
        "hypothesis_zh",
        "delta_zh",
        "validation_zh",
        "failure_modes_zh",
        "novelty_status"
      ],
      "properties": {
        "source_observation_zh": {"type": "string", "minLength": 1},
        "hypothesis_zh": {"type": "string", "minLength": 1},
        "delta_zh": {"type": "string", "minLength": 1},
        "validation_zh": {"type": "string", "minLength": 1},
        "failure_modes_zh": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "novelty_status": {
          "enum": ["unverified", "partially_checked", "prior_art_checked"]
        }
      }
    },
    "display_level": {"enum": ["inline", "collapsed", "sidecar"]},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traceable", "semantic_support", "numeric_fidelity", "modality_fidelity", "final_status"],
      "properties": {
        "traceable": {"type": "boolean"},
        "semantic_support": {"enum": ["pass", "warning", "fail"]},
        "numeric_fidelity": {"enum": ["pass", "warning", "fail"]},
        "modality_fidelity": {"enum": ["pass", "warning", "fail"]},
        "final_status": {"enum": ["pass", "warning", "fail"]}
      }
    }
  }
}
