{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xieyf1024/Litanchor-paper-reading/schemas/page-classification.schema.json",
  "title": "LitAnchor Physical Page Classification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pages"],
  "properties": {
    "schema_version": {"type": "string"},
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page_index",
          "classification",
          "classification_reason",
          "semantic_review_required",
          "semantic_reviewed",
          "review_outcome",
          "review_notes",
          "evidence_ids",
          "exclusion_reason"
        ],
        "properties": {
          "page_index": {"type": "integer", "minimum": 1},
          "classification": {
            "enum": [
              "main_content",
              "references_only",
              "appendix",
              "supplementary_content",
              "extraction_failed"
            ]
          },
          "classification_reason": {"type": "string", "minLength": 1},
          "semantic_review_required": {"type": "boolean"},
          "semantic_reviewed": {"type": "boolean"},
          "review_outcome": {
            "enum": ["pending", "evidence_captured", "no_core_claims", "excluded_reference"]
          },
          "review_notes": {"type": ["string", "null"]},
          "evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^E-[A-Za-z0-9_-]+$"}
          },
          "exclusion_reason": {"type": ["string", "null"]}
        }
      }
    }
  }
}
