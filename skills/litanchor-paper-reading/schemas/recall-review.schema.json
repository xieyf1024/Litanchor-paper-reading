{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xieyf1024/Litanchor-paper-reading/schemas/recall-review.schema.json",
  "title": "LitAnchor RecallReview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviewer_role",
    "independent_from_composer",
    "paper_type",
    "required_content_groups",
    "observed_content_groups",
    "missing_content_groups",
    "findings",
    "final_status"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "reviewer_role": {"const": "recall-reviewer"},
    "independent_from_composer": {"const": true},
    "paper_type": {
      "enum": [
        "method-algorithm",
        "model-description",
        "empirical-research",
        "review"
      ]
    },
    "required_content_groups": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "observed_content_groups": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "missing_content_groups": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "issue_type", "message"],
        "properties": {
          "severity": {"enum": ["blocker", "error", "warning", "info"]},
          "issue_type": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1}
        }
      }
    },
    "final_status": {"enum": ["pending", "pass", "warning", "fail"]}
  }
}
