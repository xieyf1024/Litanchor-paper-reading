{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xieyf1024/Litanchor-paper-reading/schemas/section-synthesis.schema.json",
  "title": "LitAnchor SectionSynthesis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "paper_type", "origin", "sections"],
  "properties": {
    "schema_version": {"type": "string"},
    "paper_type": {"type": "string", "minLength": 1},
    "origin": {"const": "auto_synthesized"},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section_target",
          "heading_zh",
          "status",
          "depth_requirement",
          "claim_ids",
          "evidence_ids",
          "coverage_groups",
          "paragraphs_zh",
          "clause_support"
        ],
        "properties": {
          "section_target": {"type": "string", "minLength": 1},
          "heading_zh": {"type": "string", "minLength": 1},
          "status": {"enum": ["present", "source_silent", "not_applicable"]},
          "depth_requirement": {"enum": ["summary", "supporting", "deep"]},
          "claim_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^C-[A-Za-z0-9_-]+$"}
          },
          "evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^E-[A-Za-z0-9_-]+$"}
          },
          "coverage_groups": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "paragraphs_zh": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "clause_support": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["clause_text_zh", "evidence_ids"],
              "properties": {
                "clause_text_zh": {"type": "string", "minLength": 1},
                "evidence_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "string", "pattern": "^E-[A-Za-z0-9_-]+$"}
                }
              }
            }
          }
        }
      }
    }
  }
}
